<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9"
    android:padding="16dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ChromeXt"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UserScript Manager"
                android:textSize="14sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_script"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB" />
    </LinearLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_scripts"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <!-- Action Buttons Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_import_file"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 Import File"
            android:textSize="12sp"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_import_url"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌐 Import URL"
            android:textSize="12sp"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_create_new"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✏️ New Script"
            android:textSize="12sp"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Script Count & Status -->
    <TextView
        android:id="@+id/tv_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 scripts installed"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginBottom="8dp" />

    <!-- Empty State Container -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_scripts"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#94A3B8"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- UserScripts List -->
    <ListView
        android:id="@+id/lv_scripts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp" />

</LinearLayout>
